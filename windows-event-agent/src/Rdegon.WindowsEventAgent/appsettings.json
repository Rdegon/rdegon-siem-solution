    "BatchSize": 200,
    "MaxSendBatch": 50,
    "TimeoutSeconds": 10,
    "IncludeXml": true,
    "AllowInvalidServerCertificate": false,
    "SharedSecret": "",
    "StateDirectory": "%ProgramData%\\RdegonSIEM\\WindowsEventAgent",
