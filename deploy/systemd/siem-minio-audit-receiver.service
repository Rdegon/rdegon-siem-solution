[Unit]
Description=SIEM MinIO audit webhook receiver
After=network-online.target
Wants=network-online.target
Before=minio.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/siem/minio-audit.env
ExecStart=/usr/bin/python3 /opt/siem/deploy/minio_audit_receiver.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/siem
UMask=0027

[Install]
WantedBy=multi-user.target
