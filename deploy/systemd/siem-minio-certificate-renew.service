[Unit]
Description=Renew the MinIO certificate from the internal step-ca
After=network-online.target minio.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/siem-minio-certificate-renew
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/minio/certs
