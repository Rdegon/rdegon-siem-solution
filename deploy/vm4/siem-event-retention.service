[Unit]
Description=SIEM event retention archive and cold cleanup
After=network-online.target siem-web.service
Wants=network-online.target
ConditionPathExists=/etc/siem/web.env

[Service]
Type=oneshot
User=rdegon
WorkingDirectory=/opt/siem/siem-solution
EnvironmentFile=/etc/siem/web.env
Environment=SIEM_CH_CONNECT_TIMEOUT_SECONDS=15
Environment=SIEM_CH_SEND_RECEIVE_TIMEOUT_SECONDS=300
ExecStart=/opt/siem/venv-web/bin/python /opt/siem/siem-solution/services/web/maintenance/retention_runner.py

[Install]
WantedBy=multi-user.target
