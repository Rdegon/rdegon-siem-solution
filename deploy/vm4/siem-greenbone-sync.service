[Unit]
Description=Rdegon SIEM Greenbone synchronization
After=network-online.target siem-web.service
Wants=network-online.target

[Service]
Type=oneshot
User=rdegon
WorkingDirectory=/opt/siem/siem-solution/services/web
EnvironmentFile=/etc/siem/web.env
Environment=SIEM_CH_CONNECT_TIMEOUT_SECONDS=15
Environment=SIEM_CH_SEND_RECEIVE_TIMEOUT_SECONDS=300
ExecStart=/opt/siem/venv-web/bin/python /opt/siem/siem-solution/deploy/vuln/rdegon_greenbone_sync.py --sync-limit 500 --import-limit 5
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=30min
