[Unit]
Description=SIEM ClickHouse standby sync
After=network-online.target clickhouse-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/siem/siem-solution
EnvironmentFile=/etc/siem/storage-standby.env
ExecStart=/opt/siem/venv-storage/bin/python /opt/siem/siem-solution/deploy/vm5_clickhouse_standby_sync.py

[Install]
WantedBy=multi-user.target
