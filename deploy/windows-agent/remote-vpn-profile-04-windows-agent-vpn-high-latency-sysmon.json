{
  "installDir": "%ProgramFiles%\\Rdegon\\WindowsEventAgent",
  "stateDirectory": "%ProgramData%\\RdegonSIEM\\WindowsEventAgent",
  "serviceName": "RdegonWindowsEventAgent",
  "displayName": "Rdegon Windows Event Agent",
  "instanceName": "AUTO_MACHINE_NAME",
  "baseUrl": "https://192.168.3.102:8443",
  "sharedSecret": "",
  "allowInvalidServerCertificate": true,
  "pollIntervalSeconds": 120,
  "batchSize": 75,
  "maxSendBatch": 20,
  "timeoutSeconds": 30,
  "includeXml": false,
  "channels": [
    {
      "name": "Security",
      "routePath": "/ingest/windows/security",
      "enabled": true
    },
    {
      "name": "System",
      "routePath": "/ingest/windows/base",
      "enabled": true
    },
    {
      "name": "Application",
      "routePath": "/ingest/windows/base",
      "enabled": true
    },
    {
      "name": "Microsoft-Windows-Sysmon/Operational",
      "routePath": "/ingest/windows/sysmon",
      "enabled": true
    },
    {
      "name": "Microsoft-Windows-PowerShell/Operational",
      "routePath": "/ingest/windows/powershell",
      "enabled": true
    },
    {
      "name": "Windows PowerShell",
      "routePath": "/ingest/windows/powershell",
      "enabled": true
    },
    {
      "name": "Microsoft-Windows-Windows Defender/Operational",
      "routePath": "/ingest/windows/base",
      "enabled": true
    },
    {
      "name": "Microsoft-Windows-WMI-Activity/Operational",
      "routePath": "/ingest/windows/base",
      "enabled": true
    },
    {
      "name": "Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational",
      "routePath": "/ingest/windows/base",
      "enabled": true
    },
    {
      "name": "Microsoft-Windows-TerminalServices-LocalSessionManager/Operational",
      "routePath": "/ingest/windows/base",
      "enabled": true
    },
    {
      "name": "Microsoft-Windows-TaskScheduler/Operational",
      "routePath": "/ingest/windows/base",
      "enabled": true
    },
    {
      "name": "Microsoft-Windows-WinRM/Operational",
      "routePath": "/ingest/windows/base",
      "enabled": true
    }
  ]
}
