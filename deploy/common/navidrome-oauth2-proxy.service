[Unit]
Description=OAuth2 Proxy for Navidrome browser SSO
After=network-online.target navidrome.service
Wants=network-online.target
Requires=navidrome.service

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/local/bin/oauth2-proxy --config /etc/navidrome/oauth2-proxy.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
